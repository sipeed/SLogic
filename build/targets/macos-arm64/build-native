#!/usr/bin/env bash
set -euo pipefail

TARGET_DIR=$(cd "$(dirname "$0")" && pwd)
BUILD_HOME=$(cd "$TARGET_DIR/../.." && pwd)
SOURCES=""
OUTPUT=""
OUT=""
CACHE=""
PRODUCTS="pulseview,slogicview,sigrok-cli"
CLEAN=0
JOBS="${BUILD_JOBS:-$(sysctl -n hw.logicalcpu)}"
MACOS_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:-15.0}"
export MACOSX_DEPLOYMENT_TARGET="$MACOS_DEPLOYMENT_TARGET"
BUILD_PREFIX="${SLOGIC_MACOS_PREFIX:-}"
RELEASE_VERSION="${RELEASE_VERSION:-0.0.0-dev}"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --sources) SOURCES=$(cd "$2" && pwd); shift 2 ;;
        --output) mkdir -p "$2"; OUTPUT=$(cd "$2" && pwd); shift 2 ;;
        --out) mkdir -p "$2"; OUT=$(cd "$2" && pwd); shift 2 ;;
        --cache) mkdir -p "$2"; CACHE=$(cd "$2" && pwd); shift 2 ;;
        --products) PRODUCTS=$2; shift 2 ;;
        --clean) CLEAN=1; shift ;;
        --version) RELEASE_VERSION=$2; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
done

if [ -n "$BUILD_PREFIX" ]; then
    [ -x "$BUILD_PREFIX/bin/pkg-config" ] || { echo "Invalid SLOGIC_MACOS_PREFIX: $BUILD_PREFIX" >&2; exit 2; }
    export PATH="$BUILD_PREFIX/lib/qt6/bin:$BUILD_PREFIX/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export PKG_CONFIG_PATH="$BUILD_PREFIX/lib/pkgconfig:$BUILD_PREFIX/share/pkgconfig"
    export CMAKE_PREFIX_PATH="$BUILD_PREFIX"
    export CPPFLAGS="-I$BUILD_PREFIX/include ${CPPFLAGS:-}"
    export LDFLAGS="-L$BUILD_PREFIX/lib ${LDFLAGS:-}"
    QT_PREFIX="$BUILD_PREFIX"
else
    eval "$(/opt/homebrew/bin/brew shellenv)"
    QT_PREFIX="$(brew --prefix qt)"
    export PATH="$QT_PREFIX/bin:$PATH"
    export PKG_CONFIG_PATH="$(brew --prefix glibmm@2.66)/lib/pkgconfig:$(brew --prefix libsigc++@2)/lib/pkgconfig:$QT_PREFIX/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
    export LDFLAGS="-L$(brew --prefix zstd)/lib ${LDFLAGS:-}"
fi
export CFLAGS="-mmacosx-version-min=$MACOS_DEPLOYMENT_TARGET ${CFLAGS:-}"
export CXXFLAGS="-mmacosx-version-min=$MACOS_DEPLOYMENT_TARGET ${CXXFLAGS:-}"
export LDFLAGS="-mmacosx-version-min=$MACOS_DEPLOYMENT_TARGET -Wl,-headerpad_max_install_names $LDFLAGS"

BUILD_ROOT="${OUT:-$BUILD_HOME/out/macos-arm64}"
if [ "$CLEAN" -eq 1 ]; then
    echo "Cleaning target workspace: $BUILD_ROOT"
    rm -rf "$BUILD_ROOT"
fi
mkdir -p "$BUILD_ROOT"
STAMP_DIR="$BUILD_ROOT/.slogic-state"
mkdir -p "$STAMP_DIR"
logic_key="${SLOGIC_BUILD_LOGIC_KEY:-unknown}"
if [ ! -f "$STAMP_DIR/build-logic" ] || [ "$(cat "$STAMP_DIR/build-logic")" != "$logic_key" ]; then
    echo "Build logic changed; invalidating macOS target workspace."
    rm -rf "$BUILD_ROOT/build-darwin" "$BUILD_ROOT/sr-darwin"
fi
for project in libsigrok libsigrokdecode pulseview slogicview sigrok-cli; do
    revision=$(git -C "$SOURCES/$project" rev-parse HEAD)
    if [ ! -f "$STAMP_DIR/$project" ] || [ "$(cat "$STAMP_DIR/$project")" != "$revision" ]; then
        case "$project" in
            libsigrok|libsigrokdecode) rm -rf "$BUILD_ROOT/build-darwin" "$BUILD_ROOT/sr-darwin" ;;
            *) rm -rf "$BUILD_ROOT/build-darwin/$project" ;;
        esac
    fi
    rsync -a --delete --exclude=.git --exclude=build "$SOURCES/$project/" "$BUILD_ROOT/$project/"
done
cp "$BUILD_HOME/common/Makefile" "$BUILD_ROOT/Makefile"

cd "$BUILD_ROOT"
make JOBS="$JOBS" BUILD_TYPE="${BUILD_TYPE:-Release}" \
    RELEASE_VERSION="$RELEASE_VERSION" \
    LIBSIGROKDECODE_CONFIGURE_OPTS="--enable-shared --disable-static" \
    PULSEVIEW_CONFIGURE_OPTS="-DCMAKE_BUILD_TYPE=${BUILD_TYPE:-Release} -DCMAKE_OSX_DEPLOYMENT_TARGET=$MACOS_DEPLOYMENT_TARGET -DCMAKE_PREFIX_PATH=$QT_PREFIX -DBoost_USE_STATIC_LIBS=OFF -DSTATIC_PKGDEPS_LIBS=OFF" \
    install

mkdir -p "$OUTPUT"

APP="$BUILD_ROOT/PulseView.app"
CONTENTS="$APP/Contents"
rm -rf "$APP"
mkdir -p "$CONTENTS/MacOS" "$CONTENTS/Frameworks" "$CONTENTS/Resources"
cp sr-darwin/bin/pulseview "$CONTENTS/MacOS/pulseview-bin"
cp sr-darwin/bin/slogicview "$CONTENTS/MacOS/slogicview-bin"
cp sr-darwin/bin/sigrok-cli "$CONTENTS/MacOS/sigrok-cli"
cp -a sr-darwin/share/libsigrokdecode "$CONTENTS/Resources/"

cat > "$CONTENTS/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleDisplayName</key><string>SLogic PulseView</string>
  <key>CFBundleExecutable</key><string>pulseview-bin</string>
  <key>CFBundleIdentifier</key><string>com.sipeed.slogic.pulseview</string>
  <key>CFBundleIconFile</key><string>PulseView.icns</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>PulseView</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$RELEASE_VERSION</string>
  <key>CFBundleVersion</key><string>$RELEASE_VERSION</string>
  <key>LSMinimumSystemVersion</key><string>$MACOS_DEPLOYMENT_TARGET</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
EOF

# Build a native multi-resolution Finder icon from PulseView's vector asset.
# qlmanage creates a document-thumbnail canvas and leaves a 48px drawing in
# its top-left corner, which looks blank in Finder. sips rasterizes the SVG at
# the requested full canvas size before producing the smaller icon variants.
ICONSET="$BUILD_ROOT/PulseView.iconset"
rm -rf "$ICONSET"
mkdir -p "$ICONSET"
ICON_MASTER="$BUILD_ROOT/PulseView-1024.png"
sips -z 1024 1024 -s format png \
    "$BUILD_ROOT/pulseview/icons/pulseview.svg" \
    --out "$ICON_MASTER" >/dev/null
for size in 16 32 128 256 512; do
    double=$((size * 2))
    sips -z "$size" "$size" "$ICON_MASTER" \
        --out "$ICONSET/icon_${size}x${size}.png" >/dev/null
    sips -z "$double" "$double" "$ICON_MASTER" \
        --out "$ICONSET/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$ICONSET" -o "$CONTENTS/Resources/PulseView.icns"
ICON_VERIFY="$BUILD_ROOT/PulseView-icon-verify.iconset"
rm -rf "$ICON_VERIFY"
iconutil -c iconset "$CONTENTS/Resources/PulseView.icns" -o "$ICON_VERIFY"
test "$(find "$ICON_VERIFY" -type f -name '*.png' | wc -l | tr -d ' ')" -eq 10
test "$(sips -g pixelWidth "$ICON_VERIFY/icon_512x512@2x.png" | awk '/pixelWidth/{print $2}')" -eq 1024
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$CONTENTS/Info.plist")" = pulseview-bin

# Build the distinct SLogicView icon into the same unsigned runtime template;
# the template is split into two independently signed application bundles
# after dependency closure is complete.
SV_ICONSET="$BUILD_ROOT/SLogicView.iconset"
rm -rf "$SV_ICONSET"
mkdir -p "$SV_ICONSET"
SV_ICON_MASTER="$BUILD_ROOT/SLogicView-1024.png"
sips -z 1024 1024 -s format png \
    "$BUILD_ROOT/slogicview/icons/pulseview.svg" \
    --out "$SV_ICON_MASTER" >/dev/null
for size in 16 32 128 256 512; do
    double=$((size * 2))
    sips -z "$size" "$size" "$SV_ICON_MASTER" \
        --out "$SV_ICONSET/icon_${size}x${size}.png" >/dev/null
    sips -z "$double" "$double" "$SV_ICON_MASTER" \
        --out "$SV_ICONSET/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$SV_ICONSET" -o "$CONTENTS/Resources/SLogicView.icns"
SV_ICON_VERIFY="$BUILD_ROOT/SLogicView-icon-verify.iconset"
rm -rf "$SV_ICON_VERIFY"
iconutil -c iconset "$CONTENTS/Resources/SLogicView.icns" -o "$SV_ICON_VERIFY"
test "$(find "$SV_ICON_VERIFY" -type f -name '*.png' | wc -l | tr -d ' ')" -eq 10
test "$(sips -g pixelWidth "$SV_ICON_VERIFY/icon_512x512@2x.png" | awk '/pixelWidth/{print $2}')" -eq 1024

# Collect non-Qt Homebrew and project dylibs before macdeployqt rewrites their
# references. Do not use --overwrite-dir for the second executable:
# invoking it for a second executable would delete libraries from the first.
first=yes
for executable in "$CONTENTS/MacOS/pulseview-bin" "$CONTENTS/MacOS/slogicview-bin" "$CONTENTS/MacOS/sigrok-cli"; do
    mode=-cd
    [ "$first" = yes ] && mode=-od
    dylibbundler "$mode" -of -b -ns -x "$executable" -d "$CONTENTS/Frameworks" \
        -p @executable_path/../Frameworks \
        -s "$BUILD_ROOT/sr-darwin/lib" -s "${BUILD_PREFIX:-/opt/homebrew}/lib"
    first=no
done

# Let macdeployqt inspect the actual Qt executable as the temporary bundle
# entrypoint. Restore the launcher entrypoint before signing.
macdeployqt "$APP" -always-overwrite

PYTHON_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
if [ -n "$BUILD_PREFIX" ]; then
    cp -L "$BUILD_PREFIX/lib/libpython$PYTHON_VERSION.dylib" "$CONTENTS/Frameworks/"
    mkdir -p "$CONTENTS/Resources/PythonRuntime/lib"
    rsync -a --exclude='__pycache__' --exclude='test' --exclude='tests' \
        "$BUILD_PREFIX/lib/python$PYTHON_VERSION" "$CONTENTS/Resources/PythonRuntime/lib/"
    PYTHON_HOME_REL="../Resources/PythonRuntime"
else
    PYTHON_FRAMEWORK="$(brew --prefix python@3.14)/Frameworks/Python.framework"
    ditto "$PYTHON_FRAMEWORK" "$CONTENTS/Frameworks/Python.framework"
    find "$CONTENTS/Frameworks/Python.framework" -type f \( -name '*.py' -o -name '*.pyc' \) -exec chmod a-x {} +
    PYTHON_HOME_REL="../Frameworks/Python.framework/Versions/$PYTHON_VERSION"
fi

# A tiny native launcher supplies a bundle-relative Python home before either
# real GUI executable initializes libsigrokdecode.
cat > "$BUILD_ROOT/gui-launcher.c" <<'EOF'
#include <mach-o/dyld.h>
#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#ifndef GUI_BINARY
#error GUI_BINARY must name the bundle's real executable
#endif
#ifndef PYTHON_HOME_REL
#error PYTHON_HOME_REL must be relative to Contents/MacOS
#endif
int main(int argc, char **argv) {
    char path[PATH_MAX], root[PATH_MAX], target[PATH_MAX], python[PATH_MAX];
    uint32_t size = sizeof(path);
    if (_NSGetExecutablePath(path, &size) != 0) return 126;
    char *slash = strrchr(path, '/');
    if (!slash) return 126;
    *slash = '\0';
    if (!realpath(path, root)) return 126;
    snprintf(target, sizeof(target), "%s/%s", root, GUI_BINARY);
    snprintf(python, sizeof(python), "%s/%s", root, PYTHON_HOME_REL);
    setenv("PYTHONHOME", python, 1);
    setenv("PYTHONDONTWRITEBYTECODE", "1", 1);
    execv(target, argv);
    return 126;
}
EOF
clang -mmacosx-version-min="$MACOS_DEPLOYMENT_TARGET" -Os \
    -DGUI_BINARY='"pulseview-bin"' -DPYTHON_HOME_REL="\"$PYTHON_HOME_REL\"" \
    "$BUILD_ROOT/gui-launcher.c" -o "$CONTENTS/MacOS/pulseview"
clang -mmacosx-version-min="$MACOS_DEPLOYMENT_TARGET" -Os \
    -DGUI_BINARY='"slogicview-bin"' -DPYTHON_HOME_REL="\"$PYTHON_HOME_REL\"" \
    "$BUILD_ROOT/gui-launcher.c" -o "$CONTENTS/MacOS/slogicview"
/usr/libexec/PlistBuddy -c 'Set :CFBundleExecutable pulseview' "$CONTENTS/Info.plist"

# Complete the dependency closure for every Mach-O in the bundle, including
# Python extension modules. macdeployqt only handles Qt's direct dependency
# graph and otherwise leaves Homebrew paths in Python and image plugins.
for pass in 1 2 3 4 5 6 7 8; do
    copied=0
    while IFS= read -r -d '' binary; do
        file "$binary" | grep -q Mach-O || continue
        while IFS= read -r dependency; do
            case "$dependency" in
                /System/*|/usr/lib/*|@executable_path/*|@loader_path/*|@rpath/*) continue ;;
                /opt/homebrew/*|/Users/*|/usr/local/*) ;;
                *) continue ;;
            esac

            if [[ "$dependency" == *'.framework/'* ]]; then
                framework_tail=${dependency#*.framework/}
                framework_name=$(basename "${dependency%%.framework/*}").framework
                bundled="$CONTENTS/Frameworks/$framework_name/$framework_tail"
                replacement="@executable_path/../Frameworks/$framework_name/$framework_tail"
                # Frameworks are copied by macdeployqt/Python deployment. An
                # external path here can also be the framework's own install ID.
                [ -e "$bundled" ] || { echo "Missing bundled framework dependency: $dependency" >&2; exit 1; }
            else
                name=$(basename "$dependency")
                bundled="$CONTENTS/Frameworks/$name"
                replacement="@executable_path/../Frameworks/$name"
                if [ ! -e "$bundled" ]; then
                    [ -e "$dependency" ] || { echo "Missing dependency: $dependency" >&2; exit 1; }
                    cp -L "$dependency" "$bundled"
                    chmod u+w "$bundled"
                    copied=1
                fi
            fi
            install_name_tool -change "$dependency" "$replacement" "$binary"
        done < <(otool -L "$binary" | tail -n +2 | awk '{print $1}')
    done < <(find "$CONTENTS" -type f -print0)
    [ "$copied" -eq 1 ] || break
done

# Normalize bundled library IDs as well, so an audit contains no build-host
# paths even when an LC_ID_DYLIB is not used for loading dependencies.
while IFS= read -r -d '' binary; do
    file "$binary" | grep -q Mach-O || continue
    id=$(otool -D "$binary" 2>/dev/null | tail -n +2 | head -n 1)
    case "$id" in
        /opt/homebrew/*|/Users/*|/usr/local/*)
            if [[ "$binary" == "$CONTENTS/Frameworks/"*.framework/* ]]; then
                relative=${binary#"$CONTENTS/Frameworks/"}
                install_name_tool -id "@executable_path/../Frameworks/$relative" "$binary"
            else
                install_name_tool -id "@executable_path/../Frameworks/$(basename "$binary")" "$binary"
            fi
            ;;
    esac
done < <(find "$CONTENTS/Frameworks" -type f -print0)

# Some non-framework Qt packages expose versioned dylib files through
# compatibility symlinks (for example libQt6Gui.6.dylib points at
# libQt6Gui.6.10.1.dylib). Copying with -L keeps the file but loses those
# aliases, leaving plugins with apparently valid yet unresolvable @rpath
# dependencies. Plugins can also introduce libraries outside macdeployqt's
# direct graph. Resolve both cases recursively and fail on an incomplete
# closure.
for pass in 1 2 3 4 5 6 7 8; do
    added=0
    while IFS= read -r -d '' binary; do
        file "$binary" | grep -q Mach-O || continue
        while IFS= read -r dependency; do
            case "$dependency" in
                @rpath/*.dylib)
                    name=${dependency#@rpath/}
                    [ -e "$CONTENTS/Frameworks/$name" ] && continue
                    stem=${name%.dylib}
                    candidate=
                    for possible in "$CONTENTS/Frameworks/$stem."*.dylib; do
                        [ -e "$possible" ] || continue
                        candidate=$possible
                        break
                    done
                    if [ -n "$candidate" ]; then
                        ln -s "$(basename "$candidate")" "$CONTENTS/Frameworks/$name"
                        added=1
                        continue
                    fi
                    source=
                    for possible in \
                        "$BUILD_ROOT/sr-darwin/lib/$name" \
                        "${BUILD_PREFIX:-/opt/homebrew}/lib/$name"; do
                        [ -e "$possible" ] || continue
                        source=$possible
                        break
                    done
                    if [ -z "$source" ]; then
                        echo "Unresolved bundled rpath dependency: $binary -> $dependency" >&2
                        exit 1
                    fi
                    cp -L "$source" "$CONTENTS/Frameworks/$name"
                    chmod u+w "$CONTENTS/Frameworks/$name"
                    install_name_tool -id \
                        "@executable_path/../Frameworks/$name" \
                        "$CONTENTS/Frameworks/$name"
                    added=1
                    ;;
            esac
        done < <(otool -L "$binary" | tail -n +2 | awk '{print $1}')
    done < <(find "$CONTENTS" -type f -print0)
    [ "$added" -eq 1 ] || break
done

# Python extension modules and some Qt plugins can retain @rpath references
# even after the matching libraries have been copied.  They may be loaded
# dynamically, so they cannot rely on an LC_RPATH inherited from the main
# executable.  Resolve these references explicitly against the Frameworks
# directory; the same layout is preserved in the portable CLI archive.
while IFS= read -r -d '' binary; do
    file "$binary" | grep -q Mach-O || continue
    while IFS= read -r dependency; do
        case "$dependency" in
            @rpath/*.dylib)
                name=${dependency#@rpath/}
                [ -e "$CONTENTS/Frameworks/$name" ] || {
                    echo "Unresolved bundled rpath dependency: $binary -> $dependency" >&2
                    exit 1
                }
                install_name_tool -change "$dependency" \
                    "@executable_path/../Frameworks/$name" "$binary"
                ;;
        esac
    done < <(otool -L "$binary" | tail -n +2 | awk '{print $1}')
done < <(find "$CONTENTS" -type f -print0)

# Libraries introduced while closing @rpath dependencies may themselves
# contain absolute references to the build prefix. Close and rewrite that
# graph once more before signing or creating the CLI archive.
for pass in 1 2 3 4 5 6 7 8; do
    copied=0
    while IFS= read -r -d '' binary; do
        file "$binary" | grep -q Mach-O || continue
        while IFS= read -r dependency; do
            case "$dependency" in
                /opt/homebrew/*|/Users/*|/usr/local/*) ;;
                *) continue ;;
            esac
            name=$(basename "$dependency")
            bundled="$CONTENTS/Frameworks/$name"
            if [ ! -e "$bundled" ]; then
                [ -e "$dependency" ] || {
                    echo "Missing transitive dependency: $binary -> $dependency" >&2
                    exit 1
                }
                cp -L "$dependency" "$bundled"
                chmod u+w "$bundled"
                install_name_tool -id \
                    "@executable_path/../Frameworks/$name" "$bundled"
                copied=1
            fi
            install_name_tool -change "$dependency" \
                "@executable_path/../Frameworks/$name" "$binary"
        done < <(otool -L "$binary" | tail -n +2 | awk '{print $1}')
    done < <(find "$CONTENTS" -type f -print0)
    [ "$copied" -eq 1 ] || break
done

# dylibbundler can map multiple original rpaths to the same bundle rpath.
# Current dyld rejects Mach-O images containing duplicate LC_RPATH commands.
while IFS= read -r -d '' binary; do
    file "$binary" | grep -q Mach-O || continue
    count=$(otool -l "$binary" | awk \
        '$1=="cmd"&&$2=="LC_RPATH"{seen=1;next} seen&&$1=="path"{if ($2=="@executable_path/../Frameworks/") n++; seen=0} END{print n+0}')
    while [ "$count" -gt 1 ]; do
        install_name_tool -delete_rpath @executable_path/../Frameworks/ "$binary"
        count=$((count - 1))
    done
done < <(find "$CONTENTS" -type f -print0)

# Info.plist does not control binary compatibility. Refuse to publish a bundle
# containing a Mach-O built for a newer macOS than the advertised minimum.
deployment_mismatch=0
while IFS= read -r -d '' binary; do
    file "$binary" | grep -q Mach-O || continue
    while IFS= read -r minos; do
        [ -n "$minos" ] || continue
        if [ "$(printf '%s\n%s\n' "$MACOS_DEPLOYMENT_TARGET" "$minos" | sort -V | tail -n 1)" != "$MACOS_DEPLOYMENT_TARGET" ]; then
            echo "Deployment target mismatch: $binary requires macOS $minos (bundle advertises $MACOS_DEPLOYMENT_TARGET)" >&2
            deployment_mismatch=1
        fi
    done < <(otool -l "$binary" | awk \
        '$1=="cmd" && ($2=="LC_BUILD_VERSION" || $2=="LC_VERSION_MIN_MACOSX") { found=1; next }
         found && ($1=="minos" || $1=="version") { print $2; found=0 }')
done < <(find "$CONTENTS" -type f -print0)
[ "$deployment_mismatch" -eq 0 ] || exit 1

SIGN_IDENTITY="${MACOS_SIGN_IDENTITY:--}"

# Split the unsigned runtime template into two applications with independent
# identities and settings domains. Each shipped App keeps only its own GUI.
SV_APP="$BUILD_ROOT/SLogicView.app"
rm -rf "$SV_APP"
ditto "$APP" "$SV_APP"
SV_CONTENTS="$SV_APP/Contents"
/usr/libexec/PlistBuddy -c 'Set :CFBundleDisplayName SLogicView' "$SV_CONTENTS/Info.plist"
/usr/libexec/PlistBuddy -c 'Set :CFBundleExecutable slogicview' "$SV_CONTENTS/Info.plist"
/usr/libexec/PlistBuddy -c 'Set :CFBundleIdentifier com.sipeed.slogic.slogicview' "$SV_CONTENTS/Info.plist"
/usr/libexec/PlistBuddy -c 'Set :CFBundleIconFile SLogicView.icns' "$SV_CONTENTS/Info.plist"
/usr/libexec/PlistBuddy -c 'Set :CFBundleName SLogicView' "$SV_CONTENTS/Info.plist"
/usr/libexec/PlistBuddy -c 'Set :CFBundleDisplayName PulseView' "$CONTENTS/Info.plist"
rm -f "$CONTENTS/MacOS/slogicview" "$CONTENTS/MacOS/slogicview-bin"
rm -f "$SV_CONTENTS/MacOS/pulseview" "$SV_CONTENTS/MacOS/pulseview-bin"

sign_bundle() {
    local app=$1
    while IFS= read -r -d '' binary; do
        file "$binary" | grep -q Mach-O || continue
        if [ "$SIGN_IDENTITY" = - ]; then
            codesign --force --sign - "$binary"
        else
            codesign --force --timestamp --options runtime --sign "$SIGN_IDENTITY" "$binary"
        fi
    done < <(find "$app/Contents" -type f -print0)
    if [ "$SIGN_IDENTITY" = - ]; then
        codesign --force --sign - "$app"
    else
        codesign --force --timestamp --options runtime --sign "$SIGN_IDENTITY" "$app"
    fi
    codesign --verify --deep --strict --verbose=2 "$app"
}

package_gui_dmg() {
    local app=$1 display_name=$2 executable=$3 volume_name=$4 output_name=$5
    local stage="$BUILD_ROOT/dmg-stage-$executable"
    local staged_app="$stage/$display_name.app"
    local dmg="$OUTPUT/$output_name"

    sign_bundle "$app"
    "$app/Contents/MacOS/$executable" --version \
        >"$BUILD_ROOT/$executable-bundle-check.txt" 2>&1

    rm -rf "$stage"
    mkdir -p "$stage"
    ditto "$app" "$staged_app"
    # Sign the exact copied tree that hdiutil will seal into the image.
    sign_bundle "$staged_app"
    ln -s /Applications "$stage/Applications"
    rm -f "$dmg"
    hdiutil create -fs HFS+ -format UDZO -volname "$volume_name" \
        -srcfolder "$stage" "$dmg"
    if [ "$SIGN_IDENTITY" = - ]; then
        codesign --force --sign - "$dmg"
    else
        codesign --force --timestamp --sign "$SIGN_IDENTITY" "$dmg"
    fi
    if [ -n "${MACOS_NOTARY_PROFILE:-}" ] && [ "$SIGN_IDENTITY" != - ]; then
        xcrun notarytool submit "$dmg" \
            --keychain-profile "$MACOS_NOTARY_PROFILE" --wait
        xcrun stapler staple "$dmg"
        xcrun stapler validate "$dmg"
        spctl --assess --type open --context context:primary-signature --verbose=2 "$dmg"
    fi
}

package_gui_dmg "$APP" PulseView pulseview "SLogic PulseView" \
    PulseView-SLogic-macos-arm64.dmg
package_gui_dmg "$SV_APP" SLogicView slogicview "SLogicView" \
    SLogicView-SLogic-macos-arm64.dmg

# Publish sigrok-cli as a relocatable command-line archive. Its executable
# keeps the same @executable_path/../Frameworks layout as the App, while the
# launcher supplies only paths relative to the extracted directory.
CLI_PORTABLE="$BUILD_ROOT/sigrok-cli-SLogic-macos-arm64"
rm -rf "$CLI_PORTABLE"
mkdir -p "$CLI_PORTABLE/bin" "$CLI_PORTABLE/Resources"
ditto "$CONTENTS/MacOS/sigrok-cli" "$CLI_PORTABLE/bin/sigrok-cli-bin"
ditto "$CONTENTS/Frameworks" "$CLI_PORTABLE/Frameworks"
ditto "$CONTENTS/Resources/libsigrokdecode" "$CLI_PORTABLE/Resources/libsigrokdecode"
[ -d "$CONTENTS/Resources/PythonRuntime" ] && \
    ditto "$CONTENTS/Resources/PythonRuntime" "$CLI_PORTABLE/Resources/PythonRuntime"
if [ -n "$BUILD_PREFIX" ]; then CLI_PYTHON_HOME='Resources/PythonRuntime'; else CLI_PYTHON_HOME="Frameworks/Python.framework/Versions/$PYTHON_VERSION"; fi
cat > "$CLI_PORTABLE/sigrok-cli" <<EOF
#!/bin/sh
set -eu
ROOT=\$(CDPATH= cd -- "\$(dirname -- "\$0")" && pwd)
export PATH="\$ROOT/bin:\${PATH:-/usr/bin:/bin}"
export PYTHONHOME="\$ROOT/$CLI_PYTHON_HOME"
export PYTHONDONTWRITEBYTECODE=1
export SIGROKDECODE_DIR="\$ROOT/Resources/libsigrokdecode/decoders"
exec "\$ROOT/bin/sigrok-cli-bin" "\$@"
EOF
chmod 755 "$CLI_PORTABLE/sigrok-cli"

portable_mismatch=0
while IFS= read -r -d '' binary; do
    file "$binary" | grep -q Mach-O || continue
    if otool -L "$binary" | tail -n +2 | awk '{print $1}' | \
        grep -E '^(/opt/homebrew|/usr/local|/Users/)' >/dev/null; then
        echo "Non-portable dependency in CLI archive: $binary" >&2
        otool -L "$binary" >&2
        portable_mismatch=1
    fi
    while IFS= read -r minos; do
        [ -n "$minos" ] || continue
        if [ "$(printf '%s\n%s\n' "$MACOS_DEPLOYMENT_TARGET" "$minos" | sort -V | tail -n 1)" != "$MACOS_DEPLOYMENT_TARGET" ]; then
            echo "CLI deployment target mismatch: $binary requires macOS $minos" >&2
            portable_mismatch=1
        fi
    done < <(otool -l "$binary" | awk \
        '$1=="cmd" && ($2=="LC_BUILD_VERSION" || $2=="LC_VERSION_MIN_MACOSX") { found=1; next }
         found && ($1=="minos" || $1=="version") { print $2; found=0 }')
done < <(find "$CLI_PORTABLE" -type f -print0)
[ "$portable_mismatch" -eq 0 ] || exit 1

CLI_CHECK="$BUILD_ROOT/sigrok-cli-portable-check.txt"
"$CLI_PORTABLE/sigrok-cli" --version >"$CLI_CHECK" 2>&1
"$CLI_PORTABLE/sigrok-cli" --list-supported >>"$CLI_CHECK" 2>&1
if grep -E '/opt/homebrew|/usr/local|/Users/.*/work/|ImportError|Traceback' "$CLI_CHECK"; then
    echo "CLI portability check failed" >&2
    exit 1
fi

rm -f "$OUTPUT/sigrok-cli-SLogic-macos-arm64.zip"
ditto -c -k --keepParent "$CLI_PORTABLE" "$OUTPUT/sigrok-cli-SLogic-macos-arm64.zip"
if [ -n "${MACOS_NOTARY_PROFILE:-}" ] && [ "$SIGN_IDENTITY" != - ]; then
    xcrun notarytool submit "$OUTPUT/sigrok-cli-SLogic-macos-arm64.zip" \
        --keychain-profile "$MACOS_NOTARY_PROFILE" --wait
fi

file "$CONTENTS/MacOS/pulseview-bin" "$SV_CONTENTS/MacOS/slogicview-bin" \
    "$OUTPUT/PulseView-SLogic-macos-arm64.dmg" \
    "$OUTPUT/SLogicView-SLogic-macos-arm64.dmg" \
    "$OUTPUT/sigrok-cli-SLogic-macos-arm64.zip"
codesign --verify --deep --strict --verbose=2 "$APP"
codesign --verify --deep --strict --verbose=2 "$SV_APP"
ls -lh "$OUTPUT/PulseView-SLogic-macos-arm64.dmg" \
    "$OUTPUT/SLogicView-SLogic-macos-arm64.dmg" \
    "$OUTPUT/sigrok-cli-SLogic-macos-arm64.zip"
printf '%s\n' "$logic_key" > "$STAMP_DIR/build-logic"
for project in libsigrok libsigrokdecode pulseview slogicview sigrok-cli; do
    git -C "$SOURCES/$project" rev-parse HEAD > "$STAMP_DIR/$project"
done
