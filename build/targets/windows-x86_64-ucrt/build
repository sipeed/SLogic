#!/usr/bin/env bash
set -euo pipefail

TARGET_DIR=$(cd "$(dirname "$0")" && pwd)
BUILD_HOME=$(cd "$TARGET_DIR/../.." && pwd)
SOURCES=""
OUTPUT=""
OUT="$BUILD_HOME/out/windows-x86_64-ucrt/${BUILD_TYPE:-release}"
CACHE="$BUILD_HOME/out/cache"
PRODUCTS="pulseview,slogicview,sigrok-cli"
JOBS="${BUILD_JOBS:-$(nproc)}"
ENGINE=""
CPUS="${CONTAINER_CPUS:-$JOBS}"
CLEAN=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --sources) SOURCES=$(realpath "$2"); shift 2 ;;
        --output) OUTPUT=$(realpath -m "$2"); shift 2 ;;
        --out) OUT=$(realpath -m "$2"); shift 2 ;;
        --cache) CACHE=$(realpath -m "$2"); shift 2 ;;
        --products) PRODUCTS=$2; shift 2 ;;
        --clean) CLEAN=1; shift ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
done

if [ -z "$SOURCES" ] || [ -z "$OUTPUT" ]; then
    echo "Usage: $0 --sources DIR --output DIR --products LIST [--out DIR] [--cache DIR] [--clean]" >&2
    exit 2
fi
ENGINE=$("$BUILD_HOME/scripts/resolve-container-engine")
for project in libsigrok libsigrokdecode; do
    test -d "$SOURCES/$project" || { echo "Missing source: $project" >&2; exit 2; }
done
IFS=, read -r -a product_list <<<"$PRODUCTS"
for product in "${product_list[@]}"; do
    case "$product" in pulseview|slogicview|sigrok-cli|all-logic|ngscopeclient) ;; *) echo "Unsupported Windows product: $product" >&2; exit 2 ;; esac
    src=$product; [ "$product" = ngscopeclient ] && src=scopehal-apps
    test -d "$SOURCES/$src" || { echo "Missing source: $src" >&2; exit 2; }
done
case ",$PRODUCTS," in *,pulseview,*) ;; *) rm -f "$OUTPUT/PulseView-SLogic-windows-x86_64.exe" ;; esac
case ",$PRODUCTS," in *,slogicview,*) ;; *) rm -f "$OUTPUT/SLogicView-SLogic-windows-x86_64.exe" ;; esac
case ",$PRODUCTS," in *,sigrok-cli,*) ;; *) rm -f "$OUTPUT/sigrok-cli-SLogic-windows-x86_64.exe" ;; esac
case ",$PRODUCTS," in *,all-logic,*) ;; *) rm -f "$OUTPUT/AllLogic-SLogic-windows-x86_64.exe" ;; esac
case ",$PRODUCTS," in *,ngscopeclient,*) ;; *) rm -f "$OUTPUT/ngscopeclient-SLogic-windows-x86_64.exe" "$OUTPUT/ngscopeclient-SLogic-"*"-windows-x86_64.exe" ;; esac

# ngscopeclient builds directly from sources/scopehal-apps (Sipeed fork); init its
# nested submodules (lib=scopehal fork with the SLogic driver, src/imgui, ...) on
# the host before the container run, since submodule gitdirs live in the
# superproject and are invisible in-container.
init_scopehal_apps_submodules() {
    local apps="$SOURCES/scopehal-apps"
    test -d "$apps/.git" -o -f "$apps/.git" || {
        echo "sources/scopehal-apps not checked out — run: git submodule update --init --recursive sources/scopehal-apps" >&2
        exit 1
    }
    git -C "$apps" submodule update --init --recursive
}
case ",$PRODUCTS," in *,ngscopeclient,*) init_scopehal_apps_submodules ;; esac

AVAILABLE_GB=$(df --output=avail -BG "$BUILD_HOME" | tail -1 | tr -dc '0-9')
if [ -z "$AVAILABLE_GB" ] || [ "$AVAILABLE_GB" -lt "${MIN_FREE_GB:-20}" ]; then
    echo "At least ${MIN_FREE_GB:-20} GiB free space is required" >&2
    exit 2
fi
if [ "$CLEAN" -eq 1 ]; then
    echo "Cleaning target workspace: $OUT"
    rm -rf "$OUT"
fi
mkdir -p "$OUT" "$OUTPUT" "$CACHE/ccache/windows-x86_64-ucrt"

IMAGE=$(CONTAINER_ENGINE="$ENGINE" "$BUILD_HOME/scripts/ensure-environment" "${SLOGIC_BUILD_ENVIRONMENT:-windows-msys2-ucrt64}")

# The engine may see fewer CPUs than the host (cgroup limits); clamp --cpus.
ENGINE_CPUS=$("$ENGINE" info --format '{{.NCPU}}' 2>/dev/null || true)
case "$ENGINE_CPUS" in ''|*[!0-9]*) ENGINE_CPUS=$("$ENGINE" info --format '{{.Host.CPUs}}' 2>/dev/null || true) ;; esac
case "$ENGINE_CPUS" in ''|*[!0-9]*) ENGINE_CPUS="" ;; esac
if [ -n "$ENGINE_CPUS" ] && [ "$ENGINE_CPUS" -gt 0 ] && [ "$CPUS" -gt "$ENGINE_CPUS" ]; then
    CPUS=$ENGINE_CPUS
fi

# Source git state is resolved on the host: submodule gitdirs live in the
# superproject and are not visible inside the container. A trailing -dirty
# marks uncommitted changes so the container rebuilds incrementally.
source_env=()
for project in libsigrok libsigrokdecode pulseview slogicview sigrok-cli all-logic ngscopeclient; do
    variable="SOURCE_${project^^}_STATE"
    variable=${variable//-/_}
    src=$project
    [ "$project" = ngscopeclient ] && src=scopehal-apps
    state=""
    if git -C "$SOURCES/$src" rev-parse --git-dir >/dev/null 2>&1; then
        state=$(git -C "$SOURCES/$src" rev-parse HEAD)
        [ -z "$(git -C "$SOURCES/$src" status --porcelain)" ] || state="$state-dirty"
    fi
    source_env+=( -e "$variable=$state" )
done

# scopehal-apps versions itself from `git describe`; sources are synced into the
# container without .git, so compute the version on the host and pass it in (the
# sipeed fork has no v-tag, so synthesize a valid vMAJOR.MINOR.PATCH-N-gSHA).
if git -C "$SOURCES/scopehal-apps" rev-parse --git-dir >/dev/null 2>&1; then
    ng_ver=$(git -C "$SOURCES/scopehal-apps" describe --always --tags 2>/dev/null)
    ng_ver_long=$(git -C "$SOURCES/scopehal-apps" describe --always --tags --long 2>/dev/null)
    case "$ng_ver" in
        v[0-9]*) ;;
        *)  ng_count=$(git -C "$SOURCES/scopehal-apps" rev-list --count HEAD 2>/dev/null || echo 0)
            ng_sha=$(git -C "$SOURCES/scopehal-apps" rev-parse --short HEAD 2>/dev/null || echo 0000000)
            ng_ver="v0.0.0-$ng_count-g$ng_sha"
            ng_ver_long="$ng_ver" ;;
    esac
    source_env+=( -e "NGSCOPECLIENT_PKG_VERSION=$ng_ver" )
    source_env+=( -e "NGSCOPECLIENT_PKG_VERSION_LONG=$ng_ver_long" )
fi

"$ENGINE" run --rm \
    --cpus="$CPUS" --memory="${CONTAINER_MEMORY:-0}" --memory-swap="${CONTAINER_MEMORY_SWAP:-0}" \
    --pids-limit=4096 \
    -e BUILD_JOBS="$JOBS" \
    -e BUILD_TYPE="${BUILD_TYPE:-Release}" \
    -e RELEASE_VERSION="${RELEASE_VERSION:-0.0.0-dev}" \
    -e PRODUCTS="$PRODUCTS" \
    -e SLOGIC_BUILD_LOGIC_KEY="${SLOGIC_BUILD_LOGIC_KEY:-unknown}" \
    "${source_env[@]}" \
    --tmpfs /tmp:rw,size=512m \
    -v "$SOURCES:/root/.wine/drive_c/sources:ro" \
    -v "$BUILD_HOME/common:/root/.wine/drive_c/support:ro" \
    -v "$TARGET_DIR:/root/.wine/drive_c/target:ro" \
    -v "$OUT:/root/.wine/drive_c/workspace" \
    -v "$CACHE/ccache/windows-x86_64-ucrt:/root/.wine/drive_c/cache/ccache" \
    -v "$OUTPUT:/root/.wine/drive_c/output" \
    "$IMAGE" bash -c "/usr/bin/msys2 -c 'bash /c/target/build-in-container'"
