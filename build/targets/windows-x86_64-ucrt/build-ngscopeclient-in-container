#!/bin/bash
set -euo pipefail

# Windows (MSYS2 UCRT64, under Wine) build + portable packaging of ngscopeclient.
# ngscope is a Vulkan/GLFW app (no Qt), self-contained: its lib submodule is the
# scopehal fork carrying the native SLogic driver (libusb + the vendored slogic
# core). This mirrors build-pulseview-in-container's cmake-build + recursive-DLL
# bundling + NSIS single-file wrapper, adapted for ngscope's build-tree run layout
# (the exe with shaders/, fonts/, icons/ beside it; scopehal searches relative to
# the executable) and without the Qt plugin/translation/Python steps.

BUILD_DIR=/c/workspace
OUTPUT=/c/output
BUILD_JOBS="${BUILD_JOBS:-$(nproc)}"
DISPLAY_NAME="ngscopeclient"
BINARY_NAME="ngscopeclient"
PORTABLE_NAME="ngscopeclient-win64-portable"
OUTPUT_NAME="ngscopeclient-SLogic-windows-x86_64.exe"
LAUNCHER_NAME="ngscopeclient.exe"
SRC="$BUILD_DIR/scopehal-apps"
BLD="$BUILD_DIR/build-win32/ngscopeclient/build"

mkdir -p "$BUILD_DIR/tmp"
export TMPDIR="$BUILD_DIR/tmp" TMP="$BUILD_DIR/tmp" TEMP="$BUILD_DIR/tmp"

echo "=== ngscopeclient Windows Portable Build (MSYS2 UCRT64) ==="
export PATH="/ucrt64/bin:$PATH"
export PKG_CONFIG_PATH="/ucrt64/lib/pkgconfig"

cd "$BUILD_DIR"

cmake_args=(
    -G Ninja
    -DCMAKE_BUILD_TYPE="${BUILD_TYPE:-Release}"
    -DDISABLE_PCH=ON
    -DBUILD_DOCS=OFF
    -DBUILD_TESTING=OFF
)
if [ -n "${NGSCOPECLIENT_PKG_VERSION:-}" ]; then
    cmake_args+=(
        -DNGSCOPECLIENT_PACKAGE_VERSION="$NGSCOPECLIENT_PKG_VERSION"
        -DNGSCOPECLIENT_PACKAGE_VERSION_LONG="${NGSCOPECLIENT_PKG_VERSION_LONG:-$NGSCOPECLIENT_PKG_VERSION}"
    )
fi

echo "Building ngscopeclient ${BUILD_TYPE:-Release} (${BUILD_JOBS} jobs)..."
if [ ! -f "$BLD/CMakeCache.txt" ]; then
    cmake -S "$SRC" -B "$BLD" "${cmake_args[@]}"
fi
cmake --build "$BLD" -j"$BUILD_JOBS"

# Locate the built executable (normally build/src/ngscopeclient/); its shaders/,
# fonts/ and icons/ are staged beside it by the CMake custom commands.
NG_BUILT="$BLD/src/ngscopeclient"
if [ ! -f "$NG_BUILT/$BINARY_NAME.exe" ]; then
    found=$(find "$BLD" -name "$BINARY_NAME.exe" -type f 2>/dev/null | head -1)
    [ -n "$found" ] && NG_BUILT=$(dirname "$found")
fi
test -f "$NG_BUILT/$BINARY_NAME.exe" || { echo "ngscopeclient.exe not found under $BLD" >&2; exit 1; }

echo "[pkg] Assembling portable payload from $NG_BUILT ..."
DIST_DIR="$BUILD_DIR/$PORTABLE_NAME"
rm -rf "$DIST_DIR"
mkdir -p "$DIST_DIR"
cp "$NG_BUILT/$BINARY_NAME.exe" "$DIST_DIR/"
# Runtime resources staged next to the built exe.
for res in shaders fonts icons; do
    [ -d "$NG_BUILT/$res" ] && cp -r "$NG_BUILT/$res" "$DIST_DIR/$res"
done
# masks/ and md/ are only staged at install time; copy from source (optional data).
for res in masks md; do
    [ -d "$SRC/src/ngscopeclient/$res" ] && cp -r "$SRC/src/ngscopeclient/$res" "$DIST_DIR/$res"
done

# Recursively resolve DLL dependencies from the UCRT64 environment.
echo "[pkg] Resolving DLL dependencies..."
UCRT64_BIN="/ucrt64/bin"
CHECKED=""
QUEUE=$(objdump -p "$DIST_DIR/$BINARY_NAME.exe" 2>/dev/null | grep "DLL Name" | awk '{print $3}' || true)
# The Vulkan loader may be loaded dynamically; make sure it is always bundled.
[ -f "$UCRT64_BIN/vulkan-1.dll" ] && cp -n "$UCRT64_BIN/vulkan-1.dll" "$DIST_DIR/" 2>/dev/null || true
QUEUE="$QUEUE vulkan-1.dll"

while [ -n "$QUEUE" ]; do
    NEW_QUEUE=""
    for dll in $QUEUE; do
        # Skip Windows system DLLs and already-checked entries.
        case "${dll,,}" in
            kernel32.dll|user32.dll|gdi32.dll|shell32.dll|advapi32.dll|ole32.dll|oleaut32.dll|imm32.dll|comdlg32.dll|ws2_32.dll|netapi32.dll|userenv.dll|crypt32.dll|winspool.drv|dnsapi.dll|iphlpapi.dll|setupapi.dll|bcrypt.dll|ntdll.dll|winmm.dll|version.dll|dwmapi.dll|uxtheme.dll|d3d11.dll|dxgi.dll|wtsapi32.dll|wsock32.dll|authz.dll|cfgmgr32.dll|comctl32.dll|propsys.dll|rpcrt4.dll|secur32.dll|shlwapi.dll|winhttp.dll|psapi.dll|dbghelp.dll|opengl32.dll|glu32.dll|hid.dll|gdiplus.dll|api-ms-win-*|ext-ms-win-*|ucrtbase.dll)
                continue ;;
        esac
        echo "$CHECKED" | grep -qw "$dll" && continue
        CHECKED="$CHECKED $dll"

        # Locate the DLL: mingw packages live in /ucrt64/bin; scopehal's own DLLs
        # (liblog, libscopehal, libscopeprotocols, ...) are built into the build tree.
        src_dll=""
        if [ -f "$UCRT64_BIN/$dll" ]; then
            src_dll="$UCRT64_BIN/$dll"
        else
            src_dll=$(find "$BLD" -name "$dll" -type f 2>/dev/null | head -1)
        fi
        if [ -n "$src_dll" ] && [ -f "$src_dll" ]; then
            cp -n "$src_dll" "$DIST_DIR/" 2>/dev/null || true
            for dep in $(objdump -p "$src_dll" 2>/dev/null | grep "DLL Name" | awk '{print $3}'); do
                echo "$CHECKED" | grep -qw "$dep" || NEW_QUEUE="$NEW_QUEUE $dep"
            done
        elif [ -f "/c/windows/system32/$dll" ]; then
            # Imported from Windows itself; must not ship in the portable payload.
            continue
        else
            echo "Missing portable DLL: $dll" >&2
            exit 1
        fi
    done
    QUEUE="$NEW_QUEUE"
done

echo "[pkg] Creating single-file self-extracting executable..."
cd "$BUILD_DIR"
rm -f "$LAUNCHER_NAME" ngscopeclient-portable.nsi "$OUTPUT/$OUTPUT_NAME"
cat > ngscopeclient-portable.nsi <<'EOF'
Unicode true
SilentInstall silent
AutoCloseWindow true
ShowInstDetails nevershow
RequestExecutionLevel user
SetCompressor /SOLID lzma
SetCompressorDictSize 64
OutFile "@LAUNCHER_NAME@"
Name "SLogic @DISPLAY_NAME@"

!include "FileFunc.nsh"

Section
    InitPluginsDir
    SetOutPath "$PLUGINSDIR\@DISPLAY_NAME@"
    File /r "@PORTABLE_NAME@\*.*"
    ${GetParameters} $R0
    ExecWait '"$PLUGINSDIR\@DISPLAY_NAME@\@BINARY_NAME@.exe" $R0' $R1
    SetErrorLevel $R1
SectionEnd
EOF
sed -i \
    -e "s|@LAUNCHER_NAME@|$LAUNCHER_NAME|g" \
    -e "s|@DISPLAY_NAME@|$DISPLAY_NAME|g" \
    -e "s|@PORTABLE_NAME@|$PORTABLE_NAME|g" \
    -e "s|@BINARY_NAME@|$BINARY_NAME|g" \
    ngscopeclient-portable.nsi
/ucrt64/bin/makensis.exe -V2 ngscopeclient-portable.nsi

if objdump -p "$LAUNCHER_NAME" | grep -Eqi 'DLL Name:[[:space:]]*msys-'; then
    echo "Native Windows package unexpectedly depends on MSYS runtime" >&2
    objdump -p "$LAUNCHER_NAME" | grep 'DLL Name' >&2
    exit 1
fi

echo "=== Done! ==="
ls -lh "$LAUNCHER_NAME"
cp "$LAUNCHER_NAME" "$OUTPUT/$OUTPUT_NAME"
