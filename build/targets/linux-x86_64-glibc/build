#!/usr/bin/env bash
set -euo pipefail

TARGET_DIR=$(cd "$(dirname "$0")" && pwd)
BUILD_HOME=$(cd "$TARGET_DIR/../.." && pwd)
SOURCES=""
OUTPUT=""
OUT="$BUILD_HOME/out/linux-x86_64-glibc/${BUILD_TYPE:-release}"
CACHE="$BUILD_HOME/out/cache"
PRODUCTS="sigrok-bridge,ngscopeclient"
JOBS="${BUILD_JOBS:-$(nproc)}"
ENGINE=""
CLEAN=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --sources) SOURCES=$(realpath "$2"); shift 2 ;;
        --output) OUTPUT=$(realpath -m "$2"); shift 2 ;;
        --out) OUT=$(realpath -m "$2"); shift 2 ;;
        --cache) CACHE=$(realpath -m "$2"); shift 2 ;;
        --products) PRODUCTS=$2; shift 2 ;;
        --clean) CLEAN=1; shift ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
done

if [ -z "$SOURCES" ] || [ -z "$OUTPUT" ]; then
    echo "Usage: $0 --sources DIR --output DIR --products LIST [--out DIR] [--cache DIR] [--clean]" >&2
    exit 2
fi
ENGINE=$("$BUILD_HOME/scripts/resolve-container-engine")
IFS=, read -r -a product_list <<<"$PRODUCTS"
for product in "${product_list[@]}"; do
    case "$product" in sigrok-bridge|ngscopeclient) ;; *) echo "Unsupported glibc product: $product" >&2; exit 2 ;; esac
    test -d "$SOURCES/$product" || { echo "Missing source: $product" >&2; exit 2; }
done
case ",$PRODUCTS," in *,sigrok-bridge,*) ;; *) rm -f "$OUTPUT/sigrok-bridge-SLogic-linux-x86_64-glibc" ;; esac
case ",$PRODUCTS," in *,ngscopeclient,*) ;; *) rm -f "$OUTPUT/ngscopeclient-SLogic-linux-x86_64-glibc.AppImage" ;; esac

# The ngscopeclient wrapper is pure-upstream scopehal-apps; its `lib` submodule
# (the scopehal fork carrying the SLogic driver) is overridden on the host here,
# before the container run and before SOURCE state is captured. This never edits
# the wrapper's tracked .gitmodules (only the nested checkout), so the release
# clean-check (which ignores submodule state for override components) still holds.
override_ngscopeclient_lib() {
    local wrapper="$SOURCES/ngscopeclient"
    local scopehal="$SOURCES/scopehal"
    # shellcheck disable=SC1091
    . "$BUILD_HOME/common/ngscopeclient-lib.env"
    local lib="$wrapper/$LIB_SUBMODULE"
    test -d "$scopehal/.git" -o -f "$scopehal/.git" || {
        echo "sources/scopehal not checked out — run: git submodule update --init --recursive sources/scopehal" >&2
        exit 1
    }
    # Ensure the scopehal fork + its nested submodules (xptools/log/VkFFT/
    # canvas_ity) are populated; idempotent on re-runs.
    git -C "$scopehal" submodule update --init --recursive
    # Init the wrapper's OTHER submodules (imgui, nativefiledialog, ...) but skip
    # its `lib` gitlink — we overlay lib from sources/scopehal instead of pulling
    # upstream scopehal, so no build-time network fetch of the fork.
    git -C "$wrapper" -c submodule."$LIB_SUBMODULE".update=none submodule update --init --recursive
    # Overlay the SLogic scopehal fork onto the wrapper's lib. --exclude=.git
    # copies the nested submodules' content as plain trees.
    mkdir -p "$lib"
    rsync -a --delete --exclude='.git' "$scopehal/" "$lib/"
}
case ",$PRODUCTS," in *,ngscopeclient,*) override_ngscopeclient_lib ;; esac

mkdir -p "$CACHE/ccache/linux-x86_64-glibc" \
    "$CACHE/cargo/linux-x86_64-glibc/registry" \
    "$CACHE/cargo/linux-x86_64-glibc/git" \
    "$CACHE/libsigrok-sys" \
    "$CACHE/downloads" \
    "$OUTPUT" "$(dirname "$OUT")"
# AppImage runtime for linuxdeploy's appimage plugin — pre-fetch and mount it so
# packaging doesn't depend on the plugin's flaky build-time GitHub download.
RUNTIME="$CACHE/downloads/runtime-x86_64"
if [ ! -s "$RUNTIME" ]; then
    echo "Downloading AppImage runtime"
    curl --fail --location --retry 3 \
        https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-x86_64 \
        --output "$RUNTIME"
    chmod +x "$RUNTIME"
fi
if [ "$CLEAN" -eq 1 ]; then
    echo "Cleaning target workspace: $OUT"
    rm -rf "$OUT"
fi
mkdir -p "$OUT"

IMAGE=$(CONTAINER_ENGINE="$ENGINE" "$BUILD_HOME/scripts/ensure-environment" "${SLOGIC_BUILD_ENVIRONMENT:-linux-glibc}")

# The engine may see fewer CPUs than the host (cgroup limits); clamp --cpus.
CPUS="${CONTAINER_CPUS:-$JOBS}"
ENGINE_CPUS=$("$ENGINE" info --format '{{.NCPU}}' 2>/dev/null || true)
case "$ENGINE_CPUS" in ''|*[!0-9]*) ENGINE_CPUS=$("$ENGINE" info --format '{{.Host.CPUs}}' 2>/dev/null || true) ;; esac
case "$ENGINE_CPUS" in ''|*[!0-9]*) ENGINE_CPUS="" ;; esac
if [ -n "$ENGINE_CPUS" ] && [ "$ENGINE_CPUS" -gt 0 ] && [ "$CPUS" -gt "$ENGINE_CPUS" ]; then
    CPUS=$ENGINE_CPUS
fi

# Source git state is resolved on the host: submodule gitdirs live in the
# superproject and are not visible inside the container. sigrok-bridge uses the
# usual "<commit>[-dirty]"; ngscopeclient uses a deterministic pinned identity
# "<wrapper_head>+lib-<override_commit>" so the expected lib override never reads
# as -dirty and the stamp changes iff the wrapper OR the pinned lib commit does.
source_env=()
if [ -f "$BUILD_HOME/common/ngscopeclient-lib.env" ]; then
    # shellcheck disable=SC1091
    . "$BUILD_HOME/common/ngscopeclient-lib.env"
fi
# libsigrok is a sibling submodule the bridge now links against (unified source).
# Fold its rev into the bridge's rebuild trigger and hand it to libsigrok-sys for
# the build stamp (in-container git can't read the submodule's gitdir).
libsigrok_src_rev="unknown"
if git -C "$SOURCES/libsigrok" rev-parse --git-dir >/dev/null 2>&1; then
    libsigrok_src_rev=$(git -C "$SOURCES/libsigrok" rev-parse HEAD)
    [ -z "$(git -C "$SOURCES/libsigrok" status --porcelain)" ] || libsigrok_src_rev="$libsigrok_src_rev-dirty"
fi

# scopehal is a sibling submodule overlaid into ngscopeclient/lib (unified source).
# Fold its rev into ngscopeclient's rebuild trigger so editing scopehal rebuilds.
scopehal_src_rev="unknown"
if git -C "$SOURCES/scopehal" rev-parse --git-dir >/dev/null 2>&1; then
    scopehal_src_rev=$(git -C "$SOURCES/scopehal" rev-parse HEAD)
    [ -z "$(git -C "$SOURCES/scopehal" status --porcelain)" ] || scopehal_src_rev="$scopehal_src_rev-dirty"
fi

for project in sigrok-bridge ngscopeclient; do
    variable="SOURCE_${project^^}_STATE"
    variable=${variable//-/_}
    state=""
    if git -C "$SOURCES/$project" rev-parse --git-dir >/dev/null 2>&1; then
        head=$(git -C "$SOURCES/$project" rev-parse HEAD)
        if [ "$project" = ngscopeclient ]; then
            state="${head}+scopehal-${scopehal_src_rev}"
            [ -z "$(git -C "$SOURCES/$project" status --porcelain --ignore-submodules=all)" ] || state="$state-dirty"
        else
            state="${head}+libsigrok-${libsigrok_src_rev}"
            [ -z "$(git -C "$SOURCES/$project" status --porcelain)" ] || state="$state-dirty"
        fi
    fi
    source_env+=( -e "$variable=$state" )
done
source_env+=( -e "LIBSIGROK_SRC_REV=$libsigrok_src_rev" )

# scopehal-apps versions itself from `git describe`, but sources are synced into
# the container without .git; compute the version on the host and pass it in so
# CMake skips git (see build/common/Makefile ngscopeclient block).
if git -C "$SOURCES/ngscopeclient" rev-parse --git-dir >/dev/null 2>&1; then
    source_env+=( -e "NGSCOPECLIENT_PKG_VERSION=$(git -C "$SOURCES/ngscopeclient" describe --always --tags 2>/dev/null)" )
    source_env+=( -e "NGSCOPECLIENT_PKG_VERSION_LONG=$(git -C "$SOURCES/ngscopeclient" describe --always --tags --long 2>/dev/null)" )
fi

"$ENGINE" run --rm \
    --cpus="$CPUS" \
    -e BUILD_JOBS="$JOBS" \
    -e BUILD_TYPE="${BUILD_TYPE:-Release}" \
    -e RELEASE_VERSION="${RELEASE_VERSION:-0.0.0-dev}" \
    -e PRODUCTS="$PRODUCTS" \
    -e SLOGIC_BUILD_LOGIC_KEY="${SLOGIC_BUILD_LOGIC_KEY:-unknown}" \
    -e LIBSIGROK_SYS_CACHE_DIR=/cache/libsigrok-sys \
    -e APPIMAGE_EXTRACT_AND_RUN=1 \
    "${source_env[@]}" \
    -v "$SOURCES:/sources:ro" \
    -v "$BUILD_HOME/common:/support:ro" \
    -v "$TARGET_DIR:/target:ro" \
    -v "$OUT:/workspace" \
    -v "$CACHE/ccache/linux-x86_64-glibc:/cache/ccache" \
    -v "$CACHE/cargo/linux-x86_64-glibc/registry:/opt/rust/cargo/registry" \
    -v "$CACHE/cargo/linux-x86_64-glibc/git:/opt/rust/cargo/git" \
    -v "$CACHE/libsigrok-sys:/cache/libsigrok-sys" \
    -v "$RUNTIME:/usr/local/share/runtime-x86_64:ro" \
    -v "$OUTPUT:/output" \
    "$IMAGE" bash /target/build-in-container
