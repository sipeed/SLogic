#!/usr/bin/env bash
set -euo pipefail

TARGET_DIR=$(cd "$(dirname "$0")" && pwd)
BUILD_HOME=$(cd "$TARGET_DIR/../.." && pwd)
SOURCES=""
OUTPUT=""
OUT="$BUILD_HOME/out/linux-x86_64-glibc/${BUILD_TYPE:-release}"
CACHE="$BUILD_HOME/out/cache"
PRODUCTS="ngscopeclient"
JOBS="${BUILD_JOBS:-$(nproc)}"
ENGINE=""
CLEAN=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --sources) SOURCES=$(realpath "$2"); shift 2 ;;
        --output) OUTPUT=$(realpath -m "$2"); shift 2 ;;
        --out) OUT=$(realpath -m "$2"); shift 2 ;;
        --cache) CACHE=$(realpath -m "$2"); shift 2 ;;
        --products) PRODUCTS=$2; shift 2 ;;
        --clean) CLEAN=1; shift ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
done

if [ -z "$SOURCES" ] || [ -z "$OUTPUT" ]; then
    echo "Usage: $0 --sources DIR --output DIR --products LIST [--out DIR] [--cache DIR] [--clean]" >&2
    exit 2
fi
ENGINE=$("$BUILD_HOME/scripts/resolve-container-engine")
IFS=, read -r -a product_list <<<"$PRODUCTS"
for product in "${product_list[@]}"; do
    case "$product" in ngscopeclient) ;; *) echo "Unsupported glibc product: $product" >&2; exit 2 ;; esac
    src=$product; [ "$product" = ngscopeclient ] && src=scopehal-apps
    test -d "$SOURCES/$src" || { echo "Missing source: $src" >&2; exit 2; }
done
# Clean any stale (unversioned) ngscopeclient artifact; the top-level build script
# adds the version to the final name.
case ",$PRODUCTS," in *,ngscopeclient,*) ;; *) rm -f "$OUTPUT/ngscopeclient-SLogic-linux-x86_64.AppImage" ;; esac

# ngscopeclient builds directly from sources/scopehal-apps (Sipeed fork). Its
# nested `lib` submodule IS the scopehal fork carrying the SLogic driver, and
# `src/imgui`, `src/imgui-node-editor`, ... are its own submodules. Init them on
# the host (submodule gitdirs live in the superproject, invisible in-container)
# before the container run and before SOURCE state is captured.
init_scopehal_apps_submodules() {
    local apps="$SOURCES/scopehal-apps"
    test -d "$apps/.git" -o -f "$apps/.git" || {
        echo "sources/scopehal-apps not checked out — run: git submodule update --init --recursive sources/scopehal-apps" >&2
        exit 1
    }
    # --recursive pulls lib (scopehal + its nested xptools/log/VkFFT/canvas_ity),
    # src/imgui, src/imgui-node-editor, src/ImGuiFileDialog,
    # src/nativefiledialog-extended and src/imgui_markdown; idempotent on re-runs.
    git -C "$apps" submodule update --init --recursive
}
case ",$PRODUCTS," in *,ngscopeclient,*) init_scopehal_apps_submodules ;; esac

mkdir -p "$CACHE/ccache/linux-x86_64-glibc" \
    "$CACHE/downloads" \
    "$OUTPUT" "$(dirname "$OUT")"
# AppImage runtime for linuxdeploy's appimage plugin — pre-fetch and mount it so
# packaging doesn't depend on the plugin's flaky build-time GitHub download.
RUNTIME="$CACHE/downloads/runtime-x86_64"
if [ ! -s "$RUNTIME" ]; then
    echo "Downloading AppImage runtime"
    curl --fail --location --retry 3 \
        https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-x86_64 \
        --output "$RUNTIME"
    chmod +x "$RUNTIME"
fi
if [ "$CLEAN" -eq 1 ]; then
    echo "Cleaning target workspace: $OUT"
    rm -rf "$OUT"
fi
mkdir -p "$OUT"

IMAGE=$(CONTAINER_ENGINE="$ENGINE" "$BUILD_HOME/scripts/ensure-environment" "${SLOGIC_BUILD_ENVIRONMENT:-linux-glibc}")

# The engine may see fewer CPUs than the host (cgroup limits); clamp --cpus.
CPUS="${CONTAINER_CPUS:-$JOBS}"
ENGINE_CPUS=$("$ENGINE" info --format '{{.NCPU}}' 2>/dev/null || true)
case "$ENGINE_CPUS" in ''|*[!0-9]*) ENGINE_CPUS=$("$ENGINE" info --format '{{.Host.CPUs}}' 2>/dev/null || true) ;; esac
case "$ENGINE_CPUS" in ''|*[!0-9]*) ENGINE_CPUS="" ;; esac
if [ -n "$ENGINE_CPUS" ] && [ "$ENGINE_CPUS" -gt 0 ] && [ "$CPUS" -gt "$ENGINE_CPUS" ]; then
    CPUS=$ENGINE_CPUS
fi

# Source git state is resolved on the host: submodule gitdirs live in the
# superproject and are not visible inside the container. Both products use the
# usual "<commit>[-dirty]". For ngscopeclient the commit is scopehal-apps's HEAD,
# which pins its nested `lib` (scopehal fork); a moved or dirty lib shows in the
# scopehal-apps working-tree status, so an edited driver reads as -dirty.
source_env=()
# scopehal-apps HEAD pins its nested lib (scopehal fork); a plain status reports a
# moved/dirty lib so driver edits force a rebuild. In-container git can't read the
# submodule gitdir, so compute the state on the host and pass it in.
ng_state=""
if git -C "$SOURCES/scopehal-apps" rev-parse --git-dir >/dev/null 2>&1; then
    ng_head=$(git -C "$SOURCES/scopehal-apps" rev-parse HEAD)
    ng_state="$ng_head"
    [ -z "$(git -C "$SOURCES/scopehal-apps" status --porcelain)" ] || ng_state="$ng_state-dirty"
fi
source_env+=( -e "SOURCE_NGSCOPECLIENT_STATE=$ng_state" )

# scopehal-apps versions itself from `git describe`, but sources are synced into
# the container without .git; compute the version on the host and pass it in so
# CMake skips git (see build/common/Makefile ngscopeclient block). The sipeed fork
# carries no version tag, so `git describe --tags` falls back to a bare SHA which
# scopehal-apps's CMake VERSIONINFO parser rejects — synthesize a valid
# vMAJOR.MINOR.PATCH-N-gSHA when there is no v-tag.
if git -C "$SOURCES/scopehal-apps" rev-parse --git-dir >/dev/null 2>&1; then
    ng_ver=$(git -C "$SOURCES/scopehal-apps" describe --always --tags 2>/dev/null)
    ng_ver_long=$(git -C "$SOURCES/scopehal-apps" describe --always --tags --long 2>/dev/null)
    case "$ng_ver" in
        v[0-9]*) ;;
        *)  ng_count=$(git -C "$SOURCES/scopehal-apps" rev-list --count HEAD 2>/dev/null || echo 0)
            ng_sha=$(git -C "$SOURCES/scopehal-apps" rev-parse --short HEAD 2>/dev/null || echo 0000000)
            ng_ver="v0.0.0-$ng_count-g$ng_sha"
            ng_ver_long="$ng_ver" ;;
    esac
    source_env+=( -e "NGSCOPECLIENT_PKG_VERSION=$ng_ver" )
    source_env+=( -e "NGSCOPECLIENT_PKG_VERSION_LONG=$ng_ver_long" )
fi

"$ENGINE" run --rm \
    --cpus="$CPUS" \
    -e BUILD_JOBS="$JOBS" \
    -e BUILD_TYPE="${BUILD_TYPE:-Release}" \
    -e RELEASE_VERSION="${RELEASE_VERSION:-0.0.0-dev}" \
    -e PRODUCTS="$PRODUCTS" \
    -e SLOGIC_BUILD_LOGIC_KEY="${SLOGIC_BUILD_LOGIC_KEY:-unknown}" \
    -e APPIMAGE_EXTRACT_AND_RUN=1 \
    "${source_env[@]}" \
    -v "$SOURCES:/sources:ro" \
    -v "$BUILD_HOME/common:/support:ro" \
    -v "$TARGET_DIR:/target:ro" \
    -v "$OUT:/workspace" \
    -v "$CACHE/ccache/linux-x86_64-glibc:/cache/ccache" \
    -v "$RUNTIME:/usr/local/share/runtime-x86_64:ro" \
    -v "$OUTPUT:/output" \
    "$IMAGE" bash /target/build-in-container
