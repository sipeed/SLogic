#!/bin/sh
# Print the GitHub release body for version X.Y.Z: the "## vX.Y.Z" section of
# CHANGELOG.md, then the same section of CHANGELOG.zh-CN.md when it has one.
# Used by the release job in .github/workflows/build.yml; run it locally to
# preview or to refresh a published release with `gh release edit --notes-file`.
set -eu

ver=${1:?usage: release-notes X.Y.Z}
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

section() {
    [ -f "$1" ] || return 0
    awk -v h="## v$ver" '
        index($0, h) == 1 && ($0 == h || substr($0, length(h) + 1, 1) == " ") { f = 1; next }
        f && /^## / { exit }
        f' "$1" | sed -e '/./,$!d' | sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}'
}

# {{firmware.<model>.<field>[.<key>]}} in a section is replaced from the firmware
# version table (tools/ota/firmware.json), e.g. {{firmware.slogic32u3.min}} or
# {{firmware.slogic32u3.update_guide.en}}; an unknown or empty entry is an
# error, so a release never shows a blank.
fill() {
    python3 -c '
import json, re, sys
table = json.load(open(sys.argv[1]))["models"]
def sub(m):
    value = table
    for key in m.group(1).split("."):
        value = value.get(key) if isinstance(value, dict) else None
    if not isinstance(value, str) or not value:
        sys.exit(f"release-notes: no firmware.{m.group(1)} in {sys.argv[1]}")
    return value
sys.stdout.write(re.sub(r"\{\{firmware\.([a-z0-9_.]+)\}\}", sub, sys.stdin.read()))
' "$root/tools/ota/firmware.json"
}

en=$(section "$root/CHANGELOG.md" | fill)
zh=$(section "$root/CHANGELOG.zh-CN.md" | fill)

if [ -z "$en" ]; then
    echo "::warning::CHANGELOG.md has no section for v$ver" >&2
    exit 0
fi

if [ -n "$zh" ]; then
    printf '*中文说明见下文。Chinese version below.*\n\n%s\n\n---\n\n## 中文说明\n\n%s\n' "$en" "$zh"
else
    printf '%s\n' "$en"
fi
