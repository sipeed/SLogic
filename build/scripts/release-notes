#!/bin/sh
# Print the GitHub release body for version X.Y.Z: the "## vX.Y.Z" section of
# CHANGELOG.md, then the same section of CHANGELOG.zh-CN.md when it has one,
# each followed by which products changed since the previous release
# (build/scripts/changed-products).
# Used by the release job in .github/workflows/build.yml; run it locally to
# preview or to refresh a published release with `gh release edit --notes-file`.
set -eu

ver=${1:?usage: release-notes X.Y.Z}
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

section() {
    [ -f "$1" ] || return 0
    awk -v h="## v$ver" '
        index($0, h) == 1 && ($0 == h || substr($0, length(h) + 1, 1) == " ") { f = 1; next }
        f && /^## / { exit }
        f' "$1" | sed -e '/./,$!d' | sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}'
}

# {{firmware.<model>.<field>[.<key>]}} in a section is replaced from the firmware
# version table: firmware.json of the web update tool (sipeed/slogic_ota_server),
# or SLOGIC_FIRMWARE_TABLE (a file or URL), e.g. {{firmware.slogic32u3.min}} or
# {{firmware.slogic32u3.update_guide.en}}; an unknown or empty entry, or a table
# that cannot be read, is an error, so a release never shows a blank.
table=${SLOGIC_FIRMWARE_TABLE:-https://raw.githubusercontent.com/sipeed/slogic_ota_server/main/firmware.json}
fill() {
    python3 -c '
import json, re, sys, urllib.request
src = sys.argv[1]
try:
    if "://" in src:
        with urllib.request.urlopen(src, timeout=30) as r:
            table = json.load(r)["models"]
    else:
        table = json.load(open(src))["models"]
except Exception as e:
    sys.exit(f"release-notes: cannot read the firmware table {src}: {e}")
def sub(m):
    value = table
    for key in m.group(1).split("."):
        value = value.get(key) if isinstance(value, dict) else None
    if not isinstance(value, str) or not value:
        sys.exit(f"release-notes: no firmware.{m.group(1)} in {sys.argv[1]}")
    return value
sys.stdout.write(re.sub(r"\{\{firmware\.([a-z0-9_.]+)\}\}", sub, sys.stdin.read()))
' "$table"
}

# Describe the release tag once it exists, else the current checkout (preview)
ref=HEAD
git -C "$root" rev-parse -q --verify "refs/tags/release-$ver" >/dev/null && ref="release-$ver"
products() {
    p=$("$root/build/scripts/changed-products" --to "$ref" --notes "$1") || exit 1
    [ -n "$p" ] && printf '\n\n%s' "$p"
    return 0
}

en=$(section "$root/CHANGELOG.md" | fill)
zh=$(section "$root/CHANGELOG.zh-CN.md" | fill)
[ -n "$en" ] && en="$en$(products en)"
[ -n "$zh" ] && zh="$zh$(products zh)"

if [ -z "$en" ]; then
    echo "::warning::CHANGELOG.md has no section for v$ver" >&2
    exit 0
fi

if [ -n "$zh" ]; then
    printf '*中文说明见下文。Chinese version below.*\n\n%s\n\n---\n\n## 中文说明\n\n%s\n' "$en" "$zh"
else
    printf '%s\n' "$en"
fi
