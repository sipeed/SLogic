# Build-time override for the scopehal-apps `lib` submodule (the scopehal fork
# carrying the SLogic driver). The superproject records pure-upstream
# scopehal-apps; each target driver applies this override on the host before
# rsyncing sources into the build workspace, and never commits it.
#
# This file lives under build/common/, which is hashed into
# SLOGIC_BUILD_LOGIC_KEY, so bumping the pin invalidates the target workspace.
# Keep in sync with the override_* keys of [ngscopeclient] in components.toml.
LIB_SUBMODULE="lib"
LIB_URL="https://github.com/sipeed/scopehal.git"
LIB_BRANCH="feat/SLogic"
LIB_COMMIT="046a8c13"
